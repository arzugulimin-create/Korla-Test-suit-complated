# ─────────────────────────────────────────────────────────────────────────────
# Korla.nl QA framework — environment variables
# Copy this file to `.env` (never commit `.env`) and adjust as needed.
# ─────────────────────────────────────────────────────────────────────────────

# Target environment. Defaults to https://korla.nl when unset.
BASE_URL=https://korla.nl

# Optional: a real registered account used ONLY by the login smoke test.
# Leave empty to keep login coverage to validation-only cases.
TEST_USER_EMAIL=jonad34604@18lover.com
TEST_USER_PASSWORD=Test.1234

# Payment E2E gate. Set to 'true' ONLY when the live WooCommerce checkout page
# is available. Prevents automation from charging real money on production.
# The checkout page is verified automatically before any payment test runs.
PAYMENT_TEST_MODE=false
